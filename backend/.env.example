# PostgreSQL
DATABASE_URL="postgres://user:password@localhost:5432/minter"

# Server
PORT=3001

# Promo signer private key
PROMO_SIGNER_PRIVATE_KEY="0x..."

# JWT Secret for SIWX session tokens (min 32 characters)
JWT_SECRET="your-secure-jwt-secret-here-min-32-chars"

# Admin domain for SIWX verification (e.g., "localhost:5173" or "admin.yoursite.com")
ADMIN_DOMAIN="localhost"

# Contract addresses
L1_TOKEN_FACTORY_ADDRESS="0x..."
L2_SUPERCHAIN_TOKEN_FACTORY_ADDRESS="0x..."

# Chain IDs
L1_CHAIN_ID=11155111
L2_CHAIN_ID=11142220

# Cloudflare R2 Storage (for token logos)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="minter-test"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
