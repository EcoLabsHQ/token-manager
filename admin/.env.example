# Backend API URL
VITE_API_URL=http://localhost:3001

# Admin API Key (must match the backend ADMIN_API_KEY)
VITE_ADMIN_API_KEY=your-admin-api-key-here

# Reown (WalletConnect) Project ID — required for wallet connection in Fee Management
# Get yours at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your-reown-project-id-here
